	executor -.-> generator;
	executor -.-> give_up;
	generator -. &nbsp;end&nbsp; .-> __end__;
	generator -.-> validator;
	validator -.-> executor;
	validator -.-> generator;
	validator -.-> give_up;
	give_up --> __end__;
